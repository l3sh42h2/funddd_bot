[Unit]
Description=funding_bot headless trading core
After=network-online.target
Wants=network-online.target
Conflicts=funding_bot-trader.service

[Service]
User=funding-core
Group=funding-core
SupplementaryGroups=funding-ipc funding-market funding-pace
WorkingDirectory=/opt/funding-bot/current
EnvironmentFile=/var/lib/funding-bot/secrets/core.env
ExecStart=/opt/funding-bot/current/.venv/bin/funding_bot core
RuntimeDirectory=funding-bot
RuntimeDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=280
KillSignal=SIGTERM
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/funding-bot/core /var/lib/funding-bot/shared /run/funding-bot
ReadOnlyPaths=/var/lib/funding-bot/collector/public
InaccessiblePaths=/var/lib/funding-bot/interface /var/lib/funding-bot/collector/funding_bot.db

[Install]
WantedBy=multi-user.target
