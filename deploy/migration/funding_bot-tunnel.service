[Unit]
Description=funding_bot public link to the stable interface port
After=network-online.target funding_bot-interface.service
Wants=network-online.target

[Service]
User=funding-interface
Group=funding-interface
ExecStart=/bin/sh -c 'exec /usr/bin/cloudflared tunnel --no-autoupdate --url http://127.0.0.1:8792 2>&1 | grep --line-buffered -o "https://[a-z0-9-]*\.trycloudflare\.com" | while read u; do echo "$u" > /var/lib/funding-bot/interface/public_url.txt; done'
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/funding-bot/interface

[Install]
WantedBy=multi-user.target
