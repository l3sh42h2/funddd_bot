[Unit]
Description=Funding spot/DEX versus five futures collector
After=network-online.target
Wants=network-online.target
Conflicts=funding_bot-collector.service

[Service]
Slice=funding-scan.slice
User=funding-collector
Group=funding-collector
SupplementaryGroups=funding-market funding-pace
WorkingDirectory=/opt/funding-bot/current
EnvironmentFile=/var/lib/funding-bot/secrets/collector.env
Environment=PYTHONPATH=/opt/funding-bot/current/src
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=FUNDING_RELEASE_MANIFEST=/opt/funding-bot/current/release-manifest.json
Environment=FUNDING_TABLE_PATH=/var/lib/funding-bot/collector/public/sf-only/table.json
ExecStart=/opt/funding-bot/current/.venv/bin/python /opt/funding-bot/scanner-profile/profile_runner.py collector
Restart=on-failure
RestartSec=10
Nice=10
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/funding-bot/collector /var/lib/funding-bot/shared
InaccessiblePaths=/var/lib/funding-bot/core /var/lib/funding-bot/interface

[Install]
WantedBy=multi-user.target
