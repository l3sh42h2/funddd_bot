# Параметры владельца фазы 2 (исполнение). Копия на сервере: runtime/owner.toml (в git не входит).
#
# ПУСТО = ЗАПРЕЩЕНО. Ни одно денежное значение не подставляется кодом: пустой ключ — live-команда отказывает
# и называет его; dry-run всё равно строит план и перечисляет, что заблокировало бы live.
# TOML не допускает «ключ =» без значения — пусто пишется как "".
# Числа — без кавычек (3, 0.5); да/нет — true/false; неизвестный ключ или опечатка — ошибка загрузки.
# "auto" — решение владельца «число подбирает бот»: правило подбора — в комментарии ключа, выбранное число
# показывается в сообщении плана и замораживается с ним (исполнитель берёт число плана, а не слово).
# Файл перечитывается на каждую команду; каждая сделка хранит замороженную копию.
# Заполнено то, что владелец задал 12.09; остальное пусто до его решения.

mode = ""                     # "dry" | "readonly" | "live"; пусто = dry. Повышение режима — через перезапуск сервиса

[telegram]
owner_id = ""                 # ваш числовой id в Telegram; пусто — командовать не может никто

[wallets]
bsc = "0xE4Ebf0815d0980E5a03f7D675F86dc5079fB8919"   # владелец 12.09: кошелёк DEX-ноги (OKX DEX, BSC)
aster_user = ""               # ОСНОВНОЙ кошелёк аккаунта Aster (ещё не дан); не адрес API-кошелька
aster_signer = ""             # адрес API-кошелька (агента) Aster; должен совпасть с ASTER_SIGNER_ADDRESS в .env

[limits]
deal_max_usd_per_leg = 500    # владелец 12.09: не больше $500 на ногу
max_open_deals = 1            # владелец 12.09: одна открытая сделка
daily_loss_stop_usd = "off"   # владелец 12.09: дневного стопа нет ("off" — решение; пусто — ещё не решено)
daily_loss_basis = ""         # "realized_costs" | "mtm"; нужен, только если стоп задан числом
min_entry_funding_pct_h = ""  # справочно: входы по команде владельца, порог только показывается в плане
min_entry_basis_bps = ""      # справочно, как выше; базис = perp_bid / dex_buy_px − 1

[dex]
slippage_pct = 3              # владелец 12.09: максимум проскальзывания DEX, %
clip_slippage_pct = ""        # более узкое проскальзывание на клип (защита от сэндвича); пусто = slippage_pct
impact_cap_pct = 3            # владелец 12.09: priceImpactProtectionPercent 3 % (у API по умолчанию 90 = защиты нет)
approve_policy = "unlimited"  # владелец 12.09: approve без предела суммы ("exact" — ровно на клип)
broadcast = "public"          # владелец 12.09: обычная публичная отправка ("okx_mev" — через OKX)
allow_tax_tokens = false      # владелец 12.09: токены с налогом на перевод не торгуем
native_reserve = 0.001        # владелец 12.09: неснижаемый остаток 0.001 BNB (газ не ограничен, но оплачиваем)
# газ: без лимита, только в отчёте (владелец 12.09)

[perp.aster]
leverage = 1                  # владелец: плечо 1x
margin_type = "ISOLATED"      # владелец: изолированная маржа
# владелец 12.09 про α и β: «искать самый сбалансированный вариант под каждый токен (максимально выгодный мне)».
# auto: план перебирает α ∈ {0.1, 0.2, 0.3, 0.5, 0.7, 1} × β по стакану (до каждого из первых 5 уровней + тик, не уже
# max(3 тика, 5 б.п.)) и берёт минимум ожидаемых издержек; при равенстве — меньшие дочерние, потом меньший β
max_slip_bps = "auto"         # β — предел цены IOC от лучшей цены, б.п.; auto — подбирается под токен в каждом плане
touch_frac_max = "auto"       # α — доля стакана на одну дочернюю заявку, 0…1; auto — доля объёма в пределах β
maker_allowed = ""            # true | false; пусто — только тейкер IOC
liq_alert_pct = "auto"        # владелец 12.09 (auto): тревога, когда до ликвидации < ½ расстояния на входе; число — %
# allow_contract_multiplier = true   # контракты с множителем (1000BONKUSDT: 1 контракт = 1000 BONK). Нет ключа или
#                                    # false — отказ во входе. Включает только владелец; выход таких сделок — всегда.
#                                    # Не включать, пока .prev на сервере — версия до фазы 1: она такую сделку не
#                                    # понимает (откат на неё остановится, пока сделка открыта)

[exec]
# владелец 12.09 про исполнение команды: «клипы оптимальные по сайзу (минимальные скорее всего), которые дает
# биржа, ждать восстановления стакана 30 сек, если издержки больше чем пол процента не исполнять, прислать новый план»
clip_max_usd = "auto"         # владелец 12.09: размер клипа выбирает оптимизатор бота
clips_max = "auto"            # владелец 12.09: без потолка числа клипов — n выбирает оптимизатор (перебор до 50)
unhedged_usd_max = "auto"     # владелец 12.09 (auto): предел риска голой ноги = plan_cost_drift_pct % клипа (0.5 %)
exec_time_max_s = "auto"      # владелец 12.09 (auto): 3 × ожидаемая длительность плана + 60 с; число — в плане
refill_wait_max_s = 30        # владелец 12.09: «ждать восстановления стакана 30 сек»
plan_cost_drift_pct = 0.5     # владелец 12.09: издержки у кнопки выросли больше 0.5 п.п. — не исполнять, новый план
auto_unwind_naked_after_s = ""   # владелец 12.09: голую ногу решает сам — авто-отката нет (пусто = никогда)
