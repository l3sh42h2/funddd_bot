# Ручные позиции владельца — то, что открыто ИМ САМИМ вне бота (руками, через интерфейс биржи/DEX), и что владелец
# попросил показывать в /cabinet со счётчиком фандинга. Копия на сервере: runtime/manual_positions.toml (в git не
# входит — репозиторий публичный, адреса кошельков сюда не кладём).
#
# Торговое ядро эту позицию не видит и не исполняет: trade.db не трогается ни этим файлом, ни его опросом
# (`funding_bot manual-poll`, крон/таймер раз в минуту, читает публичный account-API Lighter без ключей и без
# подписи, пишет runtime/manual_positions_live.json). /cabinet сам ничего не считает и не проверяет позицию —
# только показывает то, что вернул Lighter (сторону/размер/марк/накопленный фандинг его же счётчиком). PnL здесь
# никогда не считается (cost basis спота не отслеживается) — карточка честно пишет «нет подтверждённой оценки».
#
# Пока поддержана только перп-нога на Lighter (единственная площадка с публичным account-API без ключей); спот-нога
# — только для отображения (кошелёк/mint), её баланс не опрашивается.

[[position]]
id = "example-1"              # свой короткий id, латиницей — используется как ключ в _live.json
coin = "EXAMPLE"               # заголовок карточки
opened = 1789700000            # unix ts входа (владелец называет приблизительно)
note = "свободный текст под карточкой — например, обстоятельства входа"

[position.perp]
venue = "lighter"
l1_address = "0x0000000000000000000000000000000000000000"   # EVM-адрес аккаунта Lighter владельца
symbol = "EXAMPLE"             # как называется рынок в ответе Lighter (positions[].symbol)

[position.spot]
venue = "solana"
wallet = "11111111111111111111111111111111"                  # только для отображения
mint = "11111111111111111111111111111111"
